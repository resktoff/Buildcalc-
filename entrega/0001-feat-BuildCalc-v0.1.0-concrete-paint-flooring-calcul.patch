+  const r1 = validateFields({ mode: 'y', a: '2' }, schema);
+  assert.equal(r1.ok, true);
+  const r2 = validateFields({ mode: 'x', a: '2', b: '' }, schema);
+  assert.equal(r2.ok, false);
+  assert.equal(r2.errors.b.code, 'required');
+});
