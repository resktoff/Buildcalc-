diff --git a/docs/assets/js/core/calculators/concrete.js b/docs/assets/js/core/calculators/concrete.js
new file mode 100644
index 0000000..fd6fcb5
--- /dev/null
+++ b/docs/assets/js/core/calculators/concrete.js
@@ -0,0 +1,118 @@
+/**
+ * BuildCalc — concrete volume calculator (SI internally).
+ *
+ * Shapes:
+ *  - slab     : rectangular prism  V = L × W × T
+ *  - cylinder : round column       V = π × (D/2)² × H
+ *
+ * Bag yield: pre-mixed concrete bags yield ≈ 0.60 ft³ per 80 lb bag,
+ * i.e. a placed density of ≈ 2136 kg/m³ of dry mix. We use that constant for
+ * every bag size so results are consistent across units.
+ */
+
+export const CONCRETE_SHAPES = Object.freeze(['slab', 'cylinder']);
+
+/**
+ * Yield of bagged pre-mix per kg of dry mix, anchored to the industry rule
+ * "one 80 lb bag ≈ 0.60 ft³" (so 45 bags ≈ 1 yd³, 60 lb ≈ 0.45 ft³, 40 lb ≈ 0.30 ft³).
+ * 0.60 ft³ / 80 lb = 0.0075 ft³/lb → m³/kg.
+ */
+export const BAG_YIELD_M3_PER_KG = (0.6 * 0.028316846592) / (80 * 0.45359237);
+/** Equivalent placed density (≈ 2135.8 kg/m³), exported for documentation/UI. */
+export const BAG_YIELD_KG_PER_M3 = 1 / BAG_YIELD_M3_PER_KG;
+
+export const BAG_SIZES = Object.freeze([
+  { id: '25kg', massKg: 25, system: 'metric', label: '25 kg' },
+  { id: '40kg', massKg: 40, system: 'metric', label: '40 kg' },
+  { id: '50kg', massKg: 50, system: 'metric', label: '50 kg' },
+  { id: '60lb', massKg: 60 * 0.45359237, system: 'imperial', label: '60 lb' },
+  { id: '80lb', massKg: 80 * 0.45359237, system: 'imperial', label: '80 lb' },
+]);
+
+export function getBag(id) {
+  const bag = BAG_SIZES.find((b) => b.id === id);
+  if (!bag) throw new RangeError(`Unknown bag size: ${id}`);
+  return bag;
+}
+
+export function bagYieldM3(bagId) {
+  return getBag(bagId).massKg * BAG_YIELD_M3_PER_KG;
+}
+
+/**
+ * @param {object} p
+ * @param {'slab'|'cylinder'} p.shape
+ * @param {number} [p.lengthM]     slab length (m)
+ * @param {number} [p.widthM]      slab width (m)
+ * @param {number} [p.thicknessM]  slab thickness (m)
+ * @param {number} [p.diameterM]   cylinder diameter (m)
+ * @param {number} [p.heightM]     cylinder height (m)
+ * @param {number} [p.quantity=1]  number of identical elements
+ * @param {number} [p.wastePercent=0]
+ * @param {string} [p.bagId]       optional bag size for bag count
+ */
+export function calculateConcrete(p) {
+  const shape = p.shape;
+  if (!CONCRETE_SHAPES.includes(shape)) throw new RangeError(`Unknown shape: ${shape}`);
+  const quantity = p.quantity ?? 1;
+  const wastePercent = p.wastePercent ?? 0;
+  assertPositive({ quantity });
+  assertNonNegative({ wastePercent });
+
+  let unitVolumeM3;
+  const steps = [];
+  if (shape === 'slab') {
+    const { lengthM, widthM, thicknessM } = p;
+    assertPositive({ lengthM, widthM, thicknessM });
+    unitVolumeM3 = lengthM * widthM * thicknessM;
+    steps.push({ id: 'slabVolume', lengthM, widthM, thicknessM, unitVolumeM3 });
+  } else {
+    const { diameterM, heightM } = p;
+    assertPositive({ diameterM, heightM });
+    const radiusM = diameterM / 2;
+    unitVolumeM3 = Math.PI * radiusM * radiusM * heightM;
+    steps.push({ id: 'cylinderVolume', diameterM, radiusM, heightM, unitVolumeM3 });
+  }
+
+  const netVolumeM3 = unitVolumeM3 * quantity;
+  if (quantity !== 1) steps.push({ id: 'quantity', quantity, unitVolumeM3, netVolumeM3 });
+
+  const wasteVolumeM3 = netVolumeM3 * (wastePercent / 100);
+  const totalVolumeM3 = netVolumeM3 + wasteVolumeM3;
+  steps.push({ id: 'waste', wastePercent, netVolumeM3, wasteVolumeM3, totalVolumeM3 });
+
+  const result = {
+    shape,
+    quantity,
+    wastePercent,
+    unitVolumeM3,
+    netVolumeM3,
+    wasteVolumeM3,
+    totalVolumeM3,
+    bags: null,
+    bagId: null,
+    bagYieldM3: null,
+    steps,
+  };
+
+  if (p.bagId) {
+    const yieldM3 = bagYieldM3(p.bagId);
+    const bags = Math.ceil(totalVolumeM3 / yieldM3 - 1e-9);
+    result.bagId = p.bagId;
+    result.bagYieldM3 = yieldM3;
+    result.bags = bags;
+    steps.push({ id: 'bags', totalVolumeM3, bagYieldM3: yieldM3, bags, bagLabel: getBag(p.bagId).label });
+  }
+  return result;
+}
+
+function assertPositive(obj) {
+  for (const [k, v] of Object.entries(obj)) {
+    if (!Number.isFinite(v) || v <= 0) throw new RangeError(`${k} must be a positive finite number, got ${v}`);
+  }
+}
+function assertNonNegative(obj) {
+  for (const [k, v] of Object.entries(obj)) {
+    if (!Number.isFinite(v) || v < 0) throw new RangeError(`${k} must be a non-negative finite number, got ${v}`);
+  }
+}
diff --git a/docs/assets/js/core/calculators/flooring.js b/docs/assets/js/core/calculators/flooring.js
new file mode 100644
index 0000000..dc3066c
--- /dev/null
+++ b/docs/assets/js/core/calculators/flooring.js
@@ -0,0 +1,85 @@
+/**
+ * BuildCalc — flooring calculator (tiles, planks, laminate) — SI internally.
+ *
+ *  floor area        = L × W                   (room mode) or user-entered area
+ *  area with waste   = area × (1 + waste%)
+ *  piece area        = tileL × tileW
+ *  pieces            = ceil(area with waste ÷ piece area)
+ *  boxes             = ceil(pieces ÷ pieces per box)     (if pieces per box given)
+ *                    | ceil(area with waste ÷ box area)  (if box coverage given)
+ */
+
+/**
+ * @param {object} p
+ * @param {'room'|'area'} p.mode
+ * @param {number} [p.lengthM]
+ * @param {number} [p.widthM]
+ * @param {number} [p.areaM2]
+ * @param {number} [p.wastePercent=10]
+ * @param {number} [p.tileLengthM]   piece length (optional → no piece count)
+ * @param {number} [p.tileWidthM]    piece width
+ * @param {number} [p.piecesPerBox]  optional
+ * @param {number} [p.boxAreaM2]     optional alternative to piecesPerBox
+ */
+export function calculateFlooring(p) {
+  const mode = p.mode ?? 'room';
+  const wastePercent = p.wastePercent ?? 10;
+  if (!Number.isFinite(wastePercent) || wastePercent < 0) throw new RangeError('wastePercent must be >= 0');
+
+  const steps = [];
+  let areaM2;
+  if (mode === 'room') {
+    const { lengthM, widthM } = p;
+    for (const [k, v] of Object.entries({ lengthM, widthM })) {
+      if (!Number.isFinite(v) || v <= 0) throw new RangeError(`${k} must be > 0`);
+    }
+    areaM2 = lengthM * widthM;
+    steps.push({ id: 'floorArea', lengthM, widthM, areaM2 });
+  } else if (mode === 'area') {
+    if (!Number.isFinite(p.areaM2) || p.areaM2 <= 0) throw new RangeError('areaM2 must be > 0');
+    areaM2 = p.areaM2;
+    steps.push({ id: 'directArea', areaM2 });
+  } else {
+    throw new RangeError(`Unknown mode: ${mode}`);
+  }
+
+  const wasteAreaM2 = areaM2 * (wastePercent / 100);
+  const areaWithWasteM2 = areaM2 + wasteAreaM2;
+  steps.push({ id: 'waste', wastePercent, areaM2, wasteAreaM2, areaWithWasteM2 });
+
+  const result = {
+    mode,
+    wastePercent,
+    areaM2,
+    wasteAreaM2,
+    areaWithWasteM2,
+    pieceAreaM2: null,
+    pieces: null,
+    boxes: null,
+    boxBasis: null,
+    steps,
+  };
+
+  const hasTile = Number.isFinite(p.tileLengthM) && Number.isFinite(p.tileWidthM);
+  if (hasTile) {
+    if (p.tileLengthM <= 0 || p.tileWidthM <= 0) throw new RangeError('tile dimensions must be > 0');
+    const pieceAreaM2 = p.tileLengthM * p.tileWidthM;
+    const pieces = Math.ceil(areaWithWasteM2 / pieceAreaM2 - 1e-9);
+    result.pieceAreaM2 = pieceAreaM2;
+    result.pieces = pieces;
+    steps.push({ id: 'pieces', tileLengthM: p.tileLengthM, tileWidthM: p.tileWidthM, pieceAreaM2, areaWithWasteM2, pieces });
+
+    if (Number.isFinite(p.piecesPerBox) && p.piecesPerBox > 0) {
+      if (!Number.isInteger(p.piecesPerBox)) throw new RangeError('piecesPerBox must be an integer');
+      result.boxes = Math.ceil(pieces / p.piecesPerBox - 1e-9);
+      result.boxBasis = 'pieces';
+      steps.push({ id: 'boxesByPieces', pieces, piecesPerBox: p.piecesPerBox, boxes: result.boxes });
+    }
+  }
+  if (result.boxes === null && Number.isFinite(p.boxAreaM2) && p.boxAreaM2 > 0) {
+    result.boxes = Math.ceil(areaWithWasteM2 / p.boxAreaM2 - 1e-9);
+    result.boxBasis = 'area';
+    steps.push({ id: 'boxesByArea', areaWithWasteM2, boxAreaM2: p.boxAreaM2, boxes: result.boxes });
+  }
+  return result;
+}
diff --git a/docs/assets/js/core/calculators/paint.js b/docs/assets/js/core/calculators/paint.js
new file mode 100644
index 0000000..3b38a59
--- /dev/null
+++ b/docs/assets/js/core/calculators/paint.js
@@ -0,0 +1,141 @@
+/**
+ * BuildCalc — paint quantity calculator (SI internally).
+ *
+ *  wall area     = 2 × (L + W) × H            (room mode)   or user-entered area
+ *  ceiling area  = L × W                       (optional)
+ *  openings      = doors × doorArea + windows × windowArea
+ *  net area      = wall + ceiling − openings   (never below 0)
+ *  total area    = net area × coats
+ *  litres        = total area ÷ coverage (m² per litre)
+ *  with waste    = litres × (1 + waste%)
+ *  cans          = ceil(with waste ÷ can size)
+ */
+
+/** Typical opening sizes used when subtracting doors/windows. */
+export const DEFAULT_DOOR_AREA_M2 = 1.9; // ≈ 0.9 m × 2.1 m  (≈ 20 ft²)
+export const DEFAULT_WINDOW_AREA_M2 = 1.5; // ≈ 1.2 m × 1.25 m (≈ 16 ft²)
+
+/** Common container sizes (litres) per unit system. */
+export const CAN_SIZES = Object.freeze([
+  { id: '1L', litres: 1, system: 'metric', label: '1 L' },
+  { id: '4L', litres: 4, system: 'metric', label: '4 L' },
+  { id: '10L', litres: 10, system: 'metric', label: '10 L' },
+  { id: '20L', litres: 20, system: 'metric', label: '20 L' },
+  { id: '1qt', litres: 0.946352946, system: 'imperial', label: '1 qt' },
+  { id: '1gal', litres: 3.785411784, system: 'imperial', label: '1 gal' },
+  { id: '5gal', litres: 18.92705892, system: 'imperial', label: '5 gal' },
+]);
+
+export function getCan(id) {
+  const can = CAN_SIZES.find((c) => c.id === id);
+  if (!can) throw new RangeError(`Unknown can size: ${id}`);
+  return can;
+}
+
+/**
+ * @param {object} p
+ * @param {'room'|'area'} p.mode
+ * @param {number} [p.lengthM]  room length (room mode)
+ * @param {number} [p.widthM]   room width (room mode)
+ * @param {number} [p.heightM]  wall height (room mode)
+ * @param {number} [p.areaM2]   paintable area typed directly (area mode)
+ * @param {boolean} [p.includeCeiling=false] (room mode)
+ * @param {number} [p.doors=0]
+ * @param {number} [p.windows=0]
+ * @param {number} [p.doorAreaM2]
+ * @param {number} [p.windowAreaM2]
+ * @param {number} [p.coats=2]
+ * @param {number} p.coverageM2PerL  spreading rate
+ * @param {number} [p.wastePercent=0]
+ * @param {string} [p.canId]
+ */
+export function calculatePaint(p) {
+  const mode = p.mode ?? 'room';
+  const coats = p.coats ?? 2;
+  const doors = p.doors ?? 0;
+  const windows = p.windows ?? 0;
+  const doorAreaM2 = p.doorAreaM2 ?? DEFAULT_DOOR_AREA_M2;
+  const windowAreaM2 = p.windowAreaM2 ?? DEFAULT_WINDOW_AREA_M2;
+  const wastePercent = p.wastePercent ?? 0;
+  const coverageM2PerL = p.coverageM2PerL;
+  const includeCeiling = Boolean(p.includeCeiling);
+
+  if (!Number.isFinite(coverageM2PerL) || coverageM2PerL <= 0) throw new RangeError('coverageM2PerL must be > 0');
+  if (!Number.isInteger(coats) || coats < 1) throw new RangeError('coats must be an integer >= 1');
+  if (!Number.isInteger(doors) || doors < 0) throw new RangeError('doors must be an integer >= 0');
+  if (!Number.isInteger(windows) || windows < 0) throw new RangeError('windows must be an integer >= 0');
+  if (!Number.isFinite(wastePercent) || wastePercent < 0) throw new RangeError('wastePercent must be >= 0');
+
+  const steps = [];
+  let wallAreaM2;
+  let ceilingAreaM2 = 0;
+
+  if (mode === 'room') {
+    const { lengthM, widthM, heightM } = p;
+    for (const [k, v] of Object.entries({ lengthM, widthM, heightM })) {
+      if (!Number.isFinite(v) || v <= 0) throw new RangeError(`${k} must be > 0`);
+    }
+    const perimeterM = 2 * (lengthM + widthM);
+    wallAreaM2 = perimeterM * heightM;
+    steps.push({ id: 'wallArea', lengthM, widthM, heightM, perimeterM, wallAreaM2 });
+    if (includeCeiling) {
+      ceilingAreaM2 = lengthM * widthM;
+      steps.push({ id: 'ceilingArea', lengthM, widthM, ceilingAreaM2 });
+    }
+  } else if (mode === 'area') {
+    if (!Number.isFinite(p.areaM2) || p.areaM2 <= 0) throw new RangeError('areaM2 must be > 0');
+    wallAreaM2 = p.areaM2;
+    steps.push({ id: 'directArea', areaM2: wallAreaM2 });
+  } else {
+    throw new RangeError(`Unknown mode: ${mode}`);
+  }
+
+  const openingsAreaM2 = doors * doorAreaM2 + windows * windowAreaM2;
+  if (openingsAreaM2 > 0) steps.push({ id: 'openings', doors, windows, doorAreaM2, windowAreaM2, openingsAreaM2 });
+
+  const grossAreaM2 = wallAreaM2 + ceilingAreaM2;
+  const netAreaM2 = Math.max(0, grossAreaM2 - openingsAreaM2);
+  const openingsExceedArea = grossAreaM2 - openingsAreaM2 < 0;
+  steps.push({ id: 'netArea', grossAreaM2, openingsAreaM2, netAreaM2 });
+
+  const totalAreaM2 = netAreaM2 * coats;
+  steps.push({ id: 'coats', netAreaM2, coats, totalAreaM2 });
+
+  const litresNet = totalAreaM2 / coverageM2PerL;
+  steps.push({ id: 'litres', totalAreaM2, coverageM2PerL, litresNet });
+
+  const litresWaste = litresNet * (wastePercent / 100);
+  const litresTotal = litresNet + litresWaste;
+  steps.push({ id: 'waste', wastePercent, litresNet, litresWaste, litresTotal });
+
+  const result = {
+    mode,
+    coats,
+    wastePercent,
+    wallAreaM2,
+    ceilingAreaM2,
+    openingsAreaM2,
+    grossAreaM2,
+    netAreaM2,
+    totalAreaM2,
+    coverageM2PerL,
+    litresNet,
+    litresWaste,
+    litresTotal,
+    openingsExceedArea,
+    cans: null,
+    canId: null,
+    canLitres: null,
+    steps,
+  };
+
+  if (p.canId) {
+    const can = getCan(p.canId);
+    const cans = litresTotal > 0 ? Math.ceil(litresTotal / can.litres - 1e-9) : 0;
+    result.canId = can.id;
+    result.canLitres = can.litres;
+    result.cans = cans;
+    steps.push({ id: 'cans', litresTotal, canLitres: can.litres, cans, canLabel: can.label });
+  }
+  return result;
+}
diff --git a/docs/assets/js/core/format.js b/docs/assets/js/core/format.js
new file mode 100644
index 0000000..d2aa112
--- /dev/null
+++ b/docs/assets/js/core/format.js
@@ -0,0 +1,35 @@
+/**
+ * BuildCalc — number formatting & simple message interpolation.
+ */
+
+const cache = new Map();
+
+export function formatNumber(value, locale = 'en', maxFractionDigits = 2, minFractionDigits = 0) {
+  if (!Number.isFinite(value)) return '—';
+  const key = `${locale}|${maxFractionDigits}|${minFractionDigits}`;
+  let nf = cache.get(key);
+  if (!nf) {
+    nf = new Intl.NumberFormat(locale, {
+      maximumFractionDigits: maxFractionDigits,
+      minimumFractionDigits: minFractionDigits,
+    });
+    cache.set(key, nf);
+  }
+  // Avoid "-0"
+  return nf.format(Object.is(value, -0) ? 0 : value);
+}
+
+/** Pick sensible decimals: more precision for small magnitudes. */
+export function smartDecimals(value, base = 2) {
+  const abs = Math.abs(value);
+  if (abs === 0) return 0;
+  if (abs < 0.01) return base + 3;
+  if (abs < 1) return base + 1;
+  if (abs >= 1000) return Math.max(0, base - 2);
+  return base;
+}
+
+/** Replace {placeholders} in a template with values from params. */
+export function interpolate(template, params = {}) {
+  return String(template).replace(/\{(\w+)\}/g, (m, k) => (k in params ? String(params[k]) : m));
+}
diff --git a/docs/assets/js/core/units.js b/docs/assets/js/core/units.js
new file mode 100644
index 0000000..d5051e4
--- /dev/null
+++ b/docs/assets/js/core/units.js
@@ -0,0 +1,133 @@
+/**
+ * BuildCalc — unit conversion core.
+ * All calculators compute internally in SI (metres, m², m³, litres).
+ * This module converts user input to SI and results back to the display system.
+ * Dependency-free ES module shared by Node (tests/build) and the browser.
+ */
+
+/** Length units expressed in metres. */
+export const LENGTH_TO_M = Object.freeze({
+  mm: 0.001,
+  cm: 0.01,
+  m: 1,
+  in: 0.0254,
+  ft: 0.3048,
+  yd: 0.9144,
+});
+
+/** Area units expressed in square metres. */
+export const AREA_TO_M2 = Object.freeze({
+  m2: 1,
+  ft2: 0.09290304,
+  yd2: 0.83612736,
+});
+
+/** Volume units expressed in cubic metres. */
+export const VOLUME_TO_M3 = Object.freeze({
+  m3: 1,
+  L: 0.001,
+  ft3: 0.028316846592,
+  yd3: 0.764554857984,
+  gal: 0.003785411784, // US liquid gallon
+  qt: 0.000946352946, // US quart
+});
+
+/** Mass units expressed in kilograms. */
+export const MASS_TO_KG = Object.freeze({
+  kg: 1,
+  lb: 0.45359237,
+});
+
+function convert(value, from, to, table, kind) {
+  if (!(from in table)) throw new RangeError(`Unknown ${kind} unit: ${from}`);
+  if (!(to in table)) throw new RangeError(`Unknown ${kind} unit: ${to}`);
+  if (!Number.isFinite(value)) throw new TypeError(`Value must be a finite number, got ${value}`);
+  return (value * table[from]) / table[to];
+}
+
+export const convertLength = (v, from, to) => convert(v, from, to, LENGTH_TO_M, 'length');
+export const convertArea = (v, from, to) => convert(v, from, to, AREA_TO_M2, 'area');
+export const convertVolume = (v, from, to) => convert(v, from, to, VOLUME_TO_M3, 'volume');
+export const convertMass = (v, from, to) => convert(v, from, to, MASS_TO_KG, 'mass');
+
+export const toMeters = (v, unit) => convertLength(v, unit, 'm');
+export const fromMeters = (v, unit) => convertLength(v, 'm', unit);
+
+/**
+ * Coverage (paint spreading rate): area covered per unit of volume.
+ * Metric: m² per litre. Imperial: ft² per US gallon.
+ */
+export function coverageToM2PerL(value, areaUnit, volumeUnit) {
+  const m2 = convertArea(value, areaUnit, 'm2');
+  const litres = convertVolume(1, volumeUnit, 'L');
+  return m2 / litres;
+}
+export function coverageFromM2PerL(value, areaUnit, volumeUnit) {
+  const area = convertArea(value, 'm2', areaUnit);
+  const litres = convertVolume(1, volumeUnit, 'L');
+  return area * litres;
+}
+
+/**
+ * Unit systems: which unit each *dimension role* uses in the UI.
+ *  - length: large dimensions (room length, slab width)
+ *  - small:  small dimensions (slab thickness, tile size)
+ *  - area:   areas typed directly by the user
+ *  - volume: concrete volume (display)
+ *  - liquid: paint volume (display)
+ *  - coverage: paint spreading rate
+ */
+export const UNIT_SYSTEMS = Object.freeze({
+  metric: Object.freeze({
+    id: 'metric',
+    length: 'm',
+    small: 'cm',
+    area: 'm2',
+    volume: 'm3',
+    volumeAlt: 'L',
+    liquid: 'L',
+    coverageArea: 'm2',
+    coverageVolume: 'L',
+  }),
+  imperial: Object.freeze({
+    id: 'imperial',
+    length: 'ft',
+    small: 'in',
+    area: 'ft2',
+    volume: 'yd3',
+    volumeAlt: 'ft3',
+    liquid: 'gal',
+    coverageArea: 'ft2',
+    coverageVolume: 'gal',
+  }),
+});
+
+export function getSystem(id) {
+  const sys = UNIT_SYSTEMS[id];
+  if (!sys) throw new RangeError(`Unknown unit system: ${id}`);
+  return sys;
+}
+
+/**
+ * Convert a value of a given dimension role from one system to another
+ * (used when the user flips the metric/imperial toggle with values typed in).
+ */
+export function convertRole(value, role, fromSystemId, toSystemId) {
+  const from = getSystem(fromSystemId);
+  const to = getSystem(toSystemId);
+  switch (role) {
+    case 'length':
+    case 'small':
+      return convertLength(value, from[role], to[role]);
+    case 'area':
+      return convertArea(value, from.area, to.area);
+    case 'coverage': {
+      const si = coverageToM2PerL(value, from.coverageArea, from.coverageVolume);
+      return coverageFromM2PerL(si, to.coverageArea, to.coverageVolume);
+    }
+    case 'none':
+      return value;
+    default:
+      throw new RangeError(`Unknown dimension role: ${role}`);
+  }
+}
diff --git a/docs/assets/js/core/validate.js b/docs/assets/js/core/validate.js
new file mode 100644
index 0000000..6785932
--- /dev/null
+++ b/docs/assets/js/core/validate.js
@@ -0,0 +1,64 @@
+/**
+ * BuildCalc — input validation core.
+ * Returns machine-readable error codes; the UI maps codes to translated messages.
+ *
+ * Error codes:
+ *  - required : empty / missing value
+ *  - nan      : not a finite number
+ *  - min      : below minimum (strict when exclusiveMin)
+ *  - max      : above maximum
+ *  - integer  : must be a whole number
+ */
+
+export function validateNumber(raw, rule = {}) {
+  const {
+    required = true,
+    min = 0,
+    exclusiveMin = true,
+    max = Infinity,
+    integer = false,
+  } = rule;
+
+  const isEmpty = raw === '' || raw === null || raw === undefined ||
+    (typeof raw === 'number' && Number.isNaN(raw));
+
+  if (isEmpty) {
+    return required ? { ok: false, code: 'required' } : { ok: true, value: null };
+  }
+  const value = typeof raw === 'number' ? raw : Number(String(raw).replace(',', '.'));
+  if (!Number.isFinite(value)) return { ok: false, code: 'nan' };
+  if (exclusiveMin ? value <= min : value < min) return { ok: false, code: 'min', min };
+  if (value > max) return { ok: false, code: 'max', max };
+  if (integer && !Number.isInteger(value)) return { ok: false, code: 'integer' };
+  return { ok: true, value };
+}
+
+/**
+ * Validate a map of raw values against a schema { field: rule }.
+ * Rules may contain `when(values)` to make a field conditional.
+ * Returns { ok, values, errors } where errors is { field: {code,...} }.
+ */
+export function validateFields(raw, schema) {
+  const values = {};
+  const errors = {};
+  for (const [field, rule] of Object.entries(schema)) {
+    if (typeof rule.when === 'function' && !rule.when(raw)) continue;
+    const res = validateNumber(raw[field], rule);
+    if (res.ok) values[field] = res.value;
+    else errors[field] = res;
+  }
+  return { ok: Object.keys(errors).length === 0, values, errors };
+}
+
+/** Shared sanity limits (in SI) to prevent absurd results from typos. */
+export const LIMITS = Object.freeze({
+  lengthM: 1000, // 1 km
+  smallM: 5, // 5 m for thickness / tile size
+  areaM2: 1_000_000, // 100 ha
+  wastePercent: 100,
+  quantity: 10_000,
+  coats: 10,
+  openings: 500,
+  coverageM2PerL: 100,
+  piecesPerBox: 10_000,
+});
diff --git a/docs/assets/js/ui/app.js b/docs/assets/js/ui/app.js
new file mode 100644
index 0000000..9efc5d7
--- /dev/null
+++ b/docs/assets/js/ui/app.js
@@ -0,0 +1,275 @@
+/**
+ * BuildCalc UI — page bootstrap (browser).
+ * Handles: nav toggle, unit system switching, live validation + calculation.
+ */
+import { UNIT_SYSTEMS, convertRole, getSystem } from '../core/units.js';
+import { validateFields } from '../core/validate.js';
+import { formatNumber, interpolate } from '../core/format.js';
+import { makeContext, initialSystem, storeSystem, resultsToText, escapeHtml } from './common.js';
+import * as concrete from './calc-concrete.js';
+import * as paint from './calc-paint.js';
+import * as flooring from './calc-flooring.js';
+
+const CALCS = { concrete, paint, flooring };
+
+/* ---------- navigation (all pages) ---------- */
+function initNav() {
+  const btn = document.querySelector('[data-nav-toggle]');
+  const nav = document.getElementById('site-nav');
+  if (!btn || !nav) return;
+  btn.addEventListener('click', () => {
+    const open = nav.classList.toggle('is-open');
+    btn.setAttribute('aria-expanded', String(open));
+  });
+  document.addEventListener('keydown', (e) => {
+    if (e.key === 'Escape' && nav.classList.contains('is-open')) {
+      nav.classList.remove('is-open');
+      btn.setAttribute('aria-expanded', 'false');
+      btn.focus();
+    }
+  });
+}
+
+/* ---------- calculator ---------- */
+function initCalculator(form) {
+  const calc = CALCS[form.dataset.calc];
+  if (!calc) return;
+  const i18nEl = document.getElementById('bc-i18n');
+  const i18n = i18nEl ? JSON.parse(i18nEl.textContent) : null;
+  if (!i18n) return;
+
+  const results = document.getElementById('results');
+  const resultsBody = results.querySelector('[data-results-body]');
+  const summary = form.querySelector('[data-error-summary]');
+  const bar = document.querySelector('[data-result-bar]');
+  const barValue = bar ? bar.querySelector('[data-result-bar-value]') : null;
+  const unitRadios = [...form.querySelectorAll('input[name="units"]')];
+  const roleInputs = [...form.querySelectorAll('input[data-role]')];
+  const unitLabels = [...document.querySelectorAll('[data-unit-role]')];
+  const selectEls = [...form.querySelectorAll('select[data-select]')];
+  const conditionals = [...form.querySelectorAll('[data-show-when]')];
+
+  let systemId = initialSystem(i18n.lang);
+  if (!UNIT_SYSTEMS[systemId]) systemId = 'metric';
+  let ctx = makeContext(i18n, systemId);
+  let lastResultOk = false;
+
+  /* -- unit system -- */
+  function unitForRole(role, sys) {
+    switch (role) {
+      case 'length': return i18n.units[sys.length];
+      case 'small': return i18n.units[sys.small];
+      case 'area': return i18n.units[sys.area];
+      case 'coverage': return sys.id === 'metric' ? i18n.units.m2PerL : i18n.units.ft2PerGal;
+      default: return '';
+    }
+  }
+
+  function applySystem(newId, { convertValues }) {
+    const prevId = systemId;
+    systemId = newId;
+    const sys = getSystem(systemId);
+    ctx = makeContext(i18n, systemId);
+    unitRadios.forEach((r) => { r.checked = r.value === systemId; });
+    form.dataset.units = systemId;
+    unitLabels.forEach((el) => { el.textContent = unitForRole(el.dataset.unitRole, sys); });
+
+    roleInputs.forEach((input) => {
+      const role = input.dataset.role;
+      const defAttr = systemId === 'metric' ? input.dataset.defaultMetric : input.dataset.defaultImperial;
+      if (convertValues && prevId !== systemId && input.value !== '' && Number.isFinite(input.valueAsNumber) && role !== 'none') {
+        const v = convertRole(input.valueAsNumber, role, prevId, systemId);
+        input.value = String(roundSmart(v));
+      } else if (input.value === '' && defAttr !== undefined && !convertValues) {
+        input.value = defAttr;
+      }
+      if (input.dataset.placeholderMetric !== undefined) {
+        input.placeholder = systemId === 'metric' ? input.dataset.placeholderMetric : input.dataset.placeholderImperial || '';
+      }
+    });
+
+    selectEls.forEach((sel) => {
+      const def = calc.selects[sel.dataset.select];
+      if (!def) return;
+      const previous = sel.value;
+      const keepNone = sel.querySelector('option[value="none"]');
+      sel.innerHTML = '';
+      if (keepNone) sel.appendChild(keepNone);
+      def.options.filter((o) => o.system === systemId).forEach((o) => {
+        const opt = document.createElement('option');
+        opt.value = o.id;
+        opt.textContent = o.label;
+        sel.appendChild(opt);
+      });
+      const firstInit = sel.dataset.init !== '1';
+      sel.dataset.init = '1';
+      if (!firstInit && previous === 'none' && keepNone) sel.value = 'none';
+      else sel.value = def.defaults[systemId];
+    });
+
+    if (typeof calc.dynamicHelp === 'function') {
+      const help = calc.dynamicHelp(ctx);
+      for (const [field, text] of Object.entries(help)) {
+        const el = form.querySelector(`[data-help-for="${field}"]`);
+        if (el) el.textContent = text;
+      }
+    }
+  }
+
+  function roundSmart(v) {
+    const abs = Math.abs(v);
+    const digits = abs >= 100 ? 1 : abs >= 10 ? 2 : abs >= 1 ? 3 : 4;
+    return Number(v.toFixed(digits));
+  }
+
+  /* -- conditional groups -- */
+  function readRaw() {
+    const fd = new FormData(form);
+    const raw = {};
+    for (const [k, v] of fd.entries()) raw[k] = v;
+    // unchecked checkboxes are absent from FormData
+    form.querySelectorAll('input[type="checkbox"]').forEach((cb) => { if (!(cb.name in raw)) raw[cb.name] = false; });
+    return raw;
+  }
+
+  function updateConditionals(raw) {
+    conditionals.forEach((el) => {
+      const [field, values] = el.dataset.showWhen.split('=');
+      const allowed = values.split('|');
+      const show = allowed.includes(String(raw[field] ?? ''));
+      el.hidden = !show;
+      el.querySelectorAll('input,select').forEach((i) => { i.disabled = !show; });
+    });
+  }
+
+  /* -- validation UI -- */
+  function errorMessage(err) {
+    const e = i18n.common.errors;
+    switch (err.code) {
+      case 'min': return err.min === 0 ? interpolate(e.min, { min: 0 }) : interpolate(e.minInclusive, { min: formatNumber(err.min, ctx.locale, 2) });
+      case 'max': return interpolate(e.max, { max: formatNumber(err.max, ctx.locale, 0) });
+      default: return e[err.code] || e.nan;
+    }
+  }
+
+  function showErrors(errors, touchedOnly) {
+    let count = 0;
+    form.querySelectorAll('[data-field]').forEach((wrap) => {
+      const name = wrap.dataset.field;
+      const input = wrap.querySelector('input,select');
+      const errEl = wrap.querySelector('.field-error');
+      const err = errors[name];
+      const isTouched = wrap.dataset.touched === '1';
+      const show = err && (!touchedOnly || isTouched || input.value !== '');
+      if (show) {
+        count += 1;
+        wrap.classList.add('has-error');
+        input.setAttribute('aria-invalid', 'true');
+        if (errEl) { errEl.textContent = errorMessage(err); errEl.hidden = false; }
+      } else {
+        wrap.classList.remove('has-error');
+        input.removeAttribute('aria-invalid');
+        if (errEl) { errEl.textContent = ''; errEl.hidden = true; }
+      }
+    });
+    if (summary) {
+      summary.hidden = count === 0;
+      summary.textContent = count ? interpolate(i18n.common.summaryError, { count }) : '';
+    }
+    return count;
+  }
+
+  /* -- main loop -- */
+  function recalc({ touchedOnly = true } = {}) {
+    const raw = readRaw();
+    updateConditionals(raw);
+    // Re-read after enabling/disabling conditional inputs so disabled fields are excluded.
+    const live = readRaw();
+    const sys = getSystem(systemId);
+    const { ok, values, errors } = validateFields(live, calc.schema(live, sys));
+    showErrors(errors, touchedOnly);
+
+    if (bar) bar.hidden = true;
+    if (!ok) {
+      lastResultOk = false;
+      results.dataset.state = Object.values(errors).some((e) => e.code !== 'required') ? 'invalid' : 'empty';
+      resultsBody.innerHTML = `<p class="results-placeholder">${escapeHtml(results.dataset.state === 'invalid' ? i18n.common.resultsInvalid : i18n.common.resultsEmpty)}</p>`;
+      return;
+    }
+    try {
+      const result = calc.compute(values, live, sys);
+      resultsBody.innerHTML = calc.render(result, ctx, live);
+      results.dataset.state = 'ok';
+      lastResultOk = true;
+      if (bar && barValue) {
+        barValue.textContent = resultsBody.querySelector('[data-testid=primary-result]')?.textContent ?? '';
+        bar.hidden = false;
+      }
+    } catch (err) {
+      // Defensive: core threw despite validation → show invalid state, never a wrong number.
+      console.error('[BuildCalc] calculation error', err);
+      results.dataset.state = 'invalid';
+      resultsBody.innerHTML = `<p class="results-placeholder">${escapeHtml(i18n.common.resultsInvalid)}</p>`;
+      lastResultOk = false;
+    }
+  }
+
+  /* -- events -- */
+  form.addEventListener('input', (e) => {
+    const wrap = e.target.closest('[data-field]');
+    if (wrap) wrap.dataset.touched = '1';
+    if (e.target.name === 'units') return;
+    recalc();
+  });
+  form.addEventListener('change', (e) => {
+    if (e.target.name === 'units') {
+      applySystem(e.target.value, { convertValues: true });
+      storeSystem(systemId);
+      recalc();
+      return;
+    }
+    const wrap = e.target.closest('[data-field]');
+    if (wrap) wrap.dataset.touched = '1';
+    recalc();
+  });
+  form.addEventListener('submit', (e) => {
+    e.preventDefault();
+    form.querySelectorAll('[data-field]').forEach((w) => { w.dataset.touched = '1'; });
+    recalc({ touchedOnly: false });
+    const firstErr = form.querySelector('.has-error input, .has-error select');
+    if (firstErr) firstErr.focus();
+    else results.scrollIntoView({ behavior: 'smooth', block: 'start' });
+  });
+  form.addEventListener('reset', () => {
+    setTimeout(() => {
+      form.querySelectorAll('[data-field]').forEach((w) => { delete w.dataset.touched; });
+      applySystem(systemId, { convertValues: false });
+      recalc();
+      form.querySelector('input:not([type=radio]):not([type=checkbox]):not([disabled])')?.focus();
+    }, 0);
+  });
+
+  const copyBtn = results.querySelector('[data-copy]');
+  if (copyBtn) {
+    copyBtn.addEventListener('click', async () => {
+      if (!lastResultOk) return;
+      const text = resultsToText(resultsBody);
+      try {
+        await navigator.clipboard.writeText(text);
+        const original = copyBtn.textContent;
+        copyBtn.textContent = i18n.common.copied;
+        setTimeout(() => { copyBtn.textContent = original; }, 1500);
+      } catch { /* clipboard blocked */ }
+    });
+  }
+  const printBtn = results.querySelector('[data-print]');
+  if (printBtn) printBtn.addEventListener('click', () => window.print());
+
+  /* -- boot -- */
+  applySystem(systemId, { convertValues: false });
+  recalc();
+  form.dataset.ready = '1';
+}
+
+initNav();
+document.querySelectorAll('form[data-calc]').forEach(initCalculator);
diff --git a/docs/assets/js/ui/calc-concrete.js b/docs/assets/js/ui/calc-concrete.js
new file mode 100644
index 0000000..8116e03
--- /dev/null
+++ b/docs/assets/js/ui/calc-concrete.js
@@ -0,0 +1,74 @@
+import { convertLength, convertVolume } from '../core/units.js';
+import { LIMITS } from '../core/validate.js';
+import { calculateConcrete, BAG_SIZES } from '../core/calculators/concrete.js';
+import { formatStep, renderResults } from './common.js';
+
+export const id = 'concrete';
+
+export const selects = {
+  bag: { options: BAG_SIZES, defaults: { metric: '50kg', imperial: '80lb' } },
+};
+
+export function schema(raw, sys) {
+  const L = convertLength(LIMITS.lengthM, 'm', sys.length);
+  const S = convertLength(LIMITS.smallM, 'm', sys.small);
+  const isSlab = (r) => r.shape !== 'cylinder';
+  const isCyl = (r) => r.shape === 'cylinder';
+  return {
+    length: { max: L, when: isSlab },
+    width: { max: L, when: isSlab },
+    thickness: { max: S, when: isSlab },
+    diameter: { max: S, when: isCyl },
+    height: { max: L, when: isCyl },
+    quantity: { min: 1, exclusiveMin: false, max: LIMITS.quantity, integer: true },
+    waste: { min: 0, exclusiveMin: false, max: LIMITS.wastePercent },
+  };
+}
+
+export function compute(values, raw, sys) {
+  const toM = (v, unit) => convertLength(v, unit, 'm');
+  const shape = raw.shape === 'cylinder' ? 'cylinder' : 'slab';
+  const params = {
+    shape,
+    quantity: values.quantity,
+    wastePercent: values.waste,
+    bagId: raw.bag && raw.bag !== 'none' ? raw.bag : undefined,
+  };
+  if (shape === 'slab') {
+    params.lengthM = toM(values.length, sys.length);
+    params.widthM = toM(values.width, sys.length);
+    params.thicknessM = toM(values.thickness, sys.small);
+  } else {
+    params.diameterM = toM(values.diameter, sys.small);
+    params.heightM = toM(values.height, sys.length);
+  }
+  return calculateConcrete(params);
+}
+
+export function render(result, ctx) {
+  const c = ctx.i18n.calc;
+  const rows = [
+    { label: c.results.net, value: ctx.volume(result.netVolumeM3) },
+    { label: c.results.waste, value: `${ctx.volume(result.wasteVolumeM3)} (${ctx.percent(result.wastePercent)} %)` },
+  ];
+  if (result.quantity > 1) rows.push({ label: c.results.unit, value: ctx.volume(result.unitVolumeM3) });
+  if (result.bags !== null) {
+    const bag = BAG_SIZES.find((b) => b.id === result.bagId);
+    const yieldTxt = ctx.sys.id === 'imperial'
+      ? `${ctx.n(convertVolume(result.bagYieldM3, 'm3', 'ft3'), 2)} ${ctx.unitLabel('ft3')}`
+      : `${ctx.n(convertVolume(result.bagYieldM3, 'm3', 'L'), 1)} ${ctx.unitLabel('L')}`;
+    rows.push({
+      label: ctx.t('calc.results.bags', { bag: bag.label }),
+      value: ctx.int(result.bags),
+      help: ctx.t('calc.results.bagsHelp', { yield: yieldTxt }),
+    });
+  }
+  return renderResults({
+    primaryLabel: c.results.total,
+    primaryValue: ctx.volume(result.totalVolumeM3),
+    rows,
+    steps: result.steps.map((s) => formatStep(ctx, c.steps, s)),
+    howLabel: ctx.i18n.common.howCalculated,
+    disclaimer: ctx.i18n.common.disclaimer,
+  });
+}
diff --git a/docs/assets/js/ui/calc-flooring.js b/docs/assets/js/ui/calc-flooring.js
new file mode 100644
index 0000000..4c35aec
--- /dev/null
+++ b/docs/assets/js/ui/calc-flooring.js
@@ -0,0 +1,65 @@
+import { convertLength, convertArea } from '../core/units.js';
+import { LIMITS } from '../core/validate.js';
+import { calculateFlooring } from '../core/calculators/flooring.js';
+import { formatStep, renderResults } from './common.js';
+
+export const id = 'flooring';
+export const selects = {};
+
+export function schema(raw, sys) {
+  const L = convertLength(LIMITS.lengthM, 'm', sys.length);
+  const S = convertLength(LIMITS.smallM, 'm', sys.small);
+  const A = convertArea(LIMITS.areaM2, 'm2', sys.area);
+  const isRoom = (r) => r.mode !== 'area';
+  const isArea = (r) => r.mode === 'area';
+  // Tile size: optional, but if one dimension is given the other is required.
+  const tileGiven = (r) => String(r.tileLength ?? '').trim() !== '' || String(r.tileWidth ?? '').trim() !== '';
+  return {
+    length: { max: L, when: isRoom },
+    width: { max: L, when: isRoom },
+    area: { max: A, when: isArea },
+    waste: { min: 0, exclusiveMin: false, max: LIMITS.wastePercent },
+    tileLength: { max: S, required: true, when: tileGiven },
+    tileWidth: { max: S, required: true, when: tileGiven },
+    piecesPerBox: { min: 1, exclusiveMin: false, max: LIMITS.piecesPerBox, integer: true, when: (r) => r.boxMode === 'pieces' },
+    boxArea: { max: A, when: (r) => r.boxMode === 'area' },
+  };
+}
+
+export function compute(values, raw, sys) {
+  const mode = raw.mode === 'area' ? 'area' : 'room';
+  const params = { mode, wastePercent: values.waste };
+  if (mode === 'room') {
+    params.lengthM = convertLength(values.length, sys.length, 'm');
+    params.widthM = convertLength(values.width, sys.length, 'm');
+  } else {
+    params.areaM2 = convertArea(values.area, sys.area, 'm2');
+  }
+  if (values.tileLength != null && values.tileWidth != null) {
+    params.tileLengthM = convertLength(values.tileLength, sys.small, 'm');
+    params.tileWidthM = convertLength(values.tileWidth, sys.small, 'm');
+  }
+  if (raw.boxMode === 'pieces' && values.piecesPerBox != null) params.piecesPerBox = values.piecesPerBox;
+  if (raw.boxMode === 'area' && values.boxArea != null) params.boxAreaM2 = convertArea(values.boxArea, sys.area, 'm2');
+  return calculateFlooring(params);
+}
+
+export function render(result, ctx) {
+  const c = ctx.i18n.calc;
+  const rows = [
+    { label: c.results.net, value: ctx.area(result.areaM2) },
+    { label: c.results.waste, value: `${ctx.area(result.wasteAreaM2)} (${ctx.percent(result.wastePercent)} %)` },
+  ];
+  if (result.pieces !== null) {
+    rows.push({ label: c.results.pieces, value: ctx.int(result.pieces), help: `${c.results.pieceArea}: ${ctx.area(result.pieceAreaM2, 4)}` });
+  }
+  if (result.boxes !== null) rows.push({ label: c.results.boxes, value: ctx.int(result.boxes) });
+  return renderResults({
+    primaryLabel: c.results.total,
+    primaryValue: ctx.area(result.areaWithWasteM2),
+    rows,
+    steps: result.steps.map((s) => formatStep(ctx, c.steps, s)),
+    howLabel: ctx.i18n.common.howCalculated,
+    disclaimer: ctx.i18n.common.disclaimer,
+  });
+}
diff --git a/docs/assets/js/ui/calc-paint.js b/docs/assets/js/ui/calc-paint.js
new file mode 100644
index 0000000..21a5bda
--- /dev/null
+++ b/docs/assets/js/ui/calc-paint.js
@@ -0,0 +1,83 @@
+import { convertLength, convertArea, coverageToM2PerL, coverageFromM2PerL } from '../core/units.js';
+import { LIMITS } from '../core/validate.js';
+import { calculatePaint, CAN_SIZES, DEFAULT_DOOR_AREA_M2, DEFAULT_WINDOW_AREA_M2 } from '../core/calculators/paint.js';
+import { formatStep, renderResults } from './common.js';
+
+export const id = 'paint';
+
+export const selects = {
+  can: { options: CAN_SIZES, defaults: { metric: '4L', imperial: '1gal' } },
+};
+
+export function schema(raw, sys) {
+  const L = convertLength(LIMITS.lengthM, 'm', sys.length);
+  const A = convertArea(LIMITS.areaM2, 'm2', sys.area);
+  const C = coverageFromM2PerL(LIMITS.coverageM2PerL, sys.coverageArea, sys.coverageVolume);
+  const isRoom = (r) => r.mode !== 'area';
+  const isArea = (r) => r.mode === 'area';
+  return {
+    length: { max: L, when: isRoom },
+    width: { max: L, when: isRoom },
+    height: { max: L, when: isRoom },
+    area: { max: A, when: isArea },
+    doors: { min: 0, exclusiveMin: false, max: LIMITS.openings, integer: true, required: false },
+    windows: { min: 0, exclusiveMin: false, max: LIMITS.openings, integer: true, required: false },
+    coats: { min: 1, exclusiveMin: false, max: LIMITS.coats, integer: true },
+    coverage: { max: C },
+    waste: { min: 0, exclusiveMin: false, max: LIMITS.wastePercent },
+  };
+}
+
+export function compute(values, raw, sys) {
+  const toM = (v) => convertLength(v, sys.length, 'm');
+  const mode = raw.mode === 'area' ? 'area' : 'room';
+  const params = {
+    mode,
+    doors: values.doors ?? 0,
+    windows: values.windows ?? 0,
+    coats: values.coats,
+    coverageM2PerL: coverageToM2PerL(values.coverage, sys.coverageArea, sys.coverageVolume),
+    wastePercent: values.waste,
+    includeCeiling: raw.ceiling === 'on' || raw.ceiling === true,
+    canId: raw.can && raw.can !== 'none' ? raw.can : undefined,
+  };
+  if (mode === 'room') {
+    params.lengthM = toM(values.length);
+    params.widthM = toM(values.width);
+    params.heightM = toM(values.height);
+  } else {
+    params.areaM2 = convertArea(values.area, sys.area, 'm2');
+  }
+  return calculatePaint(params);
+}
+
+/** Help text for openings in display units (used by app.js on unit toggle). */
+export function dynamicHelp(ctx) {
+  return {
+    doors: ctx.t('calc.fields.doorsHelp', { area: ctx.area(DEFAULT_DOOR_AREA_M2, 1) }),
+    windows: ctx.t('calc.fields.windowsHelp', { area: ctx.area(DEFAULT_WINDOW_AREA_M2, 1) }),
+  };
+}
+
+export function render(result, ctx) {
+  const c = ctx.i18n.calc;
+  const rows = [
+    { label: c.results.net, value: ctx.liquid(result.litresNet) },
+    { label: c.results.area, value: ctx.area(result.netAreaM2) },
+    { label: ctx.t('calc.results.areaCoats', { coats: ctx.int(result.coats) }), value: ctx.area(result.totalAreaM2) },
+  ];
+  if (result.openingsAreaM2 > 0) rows.push({ label: c.results.openings, value: ctx.area(result.openingsAreaM2) });
+  if (result.cans !== null) {
+    const can = CAN_SIZES.find((k) => k.id === result.canId);
+    rows.push({ label: ctx.t('calc.results.cans', { can: can.label }), value: ctx.int(result.cans) });
+  }
+  return renderResults({
+    primaryLabel: c.results.total,
+    primaryValue: ctx.liquid(result.litresTotal),
+    rows,
+    warning: result.openingsExceedArea ? c.results.openingsWarning : null,
+    steps: result.steps.map((s) => formatStep(ctx, c.steps, s)),
+    howLabel: ctx.i18n.common.howCalculated,
+    disclaimer: ctx.i18n.common.disclaimer,
+  });
+}
diff --git a/docs/assets/js/ui/common.js b/docs/assets/js/ui/common.js
new file mode 100644
index 0000000..95d21b2
--- /dev/null
+++ b/docs/assets/js/ui/common.js
@@ -0,0 +1,139 @@
+/**
+ * BuildCalc UI — shared helpers for calculator pages (browser only).
+ */
+import { getSystem, convertLength, convertArea, convertVolume, coverageFromM2PerL } from '../core/units.js';
+import { formatNumber, smartDecimals, interpolate } from '../core/format.js';
+
+export const STORAGE_KEY = 'bc.units';
+
+export function escapeHtml(s) {
+  return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+}
+
+/** Build a formatting context bound to the active language + unit system. */
+export function makeContext(i18n, systemId) {
+  const sys = getSystem(systemId);
+  const locale = i18n.locale || 'en';
+  const u = i18n.units;
+  const n = (v, d = 2) => formatNumber(v, locale, d);
+  const ctx = {
+    sys,
+    locale,
+    i18n,
+    t: (path, params) => interpolate(lookup(i18n, path) ?? path, params),
+    n,
+    unitLabel: (unitId) => u[unitId] ?? unitId,
+    length(vM, decimals) {
+      const v = convertLength(vM, 'm', sys.length);
+      return `${n(v, decimals ?? smartDecimals(v, 2))} ${u[sys.length]}`;
+    },
+    small(vM, decimals) {
+      const v = convertLength(vM, 'm', sys.small);
+      return `${n(v, decimals ?? smartDecimals(v, 1))} ${u[sys.small]}`;
+    },
+    area(vM2, decimals) {
+      const v = convertArea(vM2, 'm2', sys.area);
+      return `${n(v, decimals ?? smartDecimals(v, 2))} ${u[sys.area]}`;
+    },
+    volume(vM3) {
+      const main = convertVolume(vM3, 'm3', sys.volume);
+      const txt = `${n(main, smartDecimals(main, 3))} ${u[sys.volume]}`;
+      if (sys.id === 'imperial') {
+        const alt = convertVolume(vM3, 'm3', sys.volumeAlt);
+        return `${txt} (${n(alt, smartDecimals(alt, 2))} ${u[sys.volumeAlt]})`;
+      }
+      return txt;
+    },
+    liquid(vL) {
+      const v = convertVolume(vL, 'L', sys.liquid);
+      return `${n(v, smartDecimals(v, 2))} ${u[sys.liquid]}`;
+    },
+    coverage(vM2PerL) {
+      const v = coverageFromM2PerL(vM2PerL, sys.coverageArea, sys.coverageVolume);
+      return `${n(v, smartDecimals(v, 1))} ${sys.id === 'metric' ? u.m2PerL : u.ft2PerGal}`;
+    },
+    percent: (v) => `${n(v, 2)}`,
+    int: (v) => n(v, 0),
+  };
+  return ctx;
+}
+
+function lookup(obj, path) {
+  return path.split('.').reduce((o, k) => (o && k in o ? o[k] : undefined), obj);
+}
+
+/**
+ * Format a calculator step into a localized sentence, converting SI params
+ * into the active unit system by key suffix convention:
+ *   *M → length, *M2 → area, *M3 → volume, *PerL → coverage,
+ *   litres* / canLitres → liquid, *Percent → %, everything else raw.
+ */
+export function formatStep(ctx, stepsI18n, step) {
+  const tpl = stepsI18n[step.id];
+  if (!tpl) return '';
+  const params = {};
+  for (const [k, v] of Object.entries(step)) {
+    if (k === 'id') continue;
+    if (typeof v !== 'number') { params[k] = v; continue; }
+    if (k.endsWith('M3')) params[k] = ctx.volume(v);
+    else if (k.endsWith('M2')) params[k] = ctx.area(v);
+    else if (k.endsWith('M')) params[k] = ctx.length(v);
+    else if (k.endsWith('PerL')) params[k] = ctx.coverage(v);
+    else if (k.startsWith('litres') || k === 'canLitres') params[k] = ctx.liquid(v);
+    else if (k.endsWith('Percent')) params[k] = ctx.percent(v);
+    else params[k] = ctx.int(v);
+  }
+  return interpolate(tpl, params);
+}
+
+/** Render a results block: primary figure + list of secondary rows + steps. */
+export function renderResults({ primaryLabel, primaryValue, rows = [], warning = null, steps = [], howLabel, disclaimer }) {
+  const rowsHtml = rows
+    .filter((r) => r && r.value !== null && r.value !== undefined)
+    .map((r) => `<div class="result-row"><dt>${escapeHtml(r.label)}</dt><dd>${escapeHtml(r.value)}${r.help ? `<small>${escapeHtml(r.help)}</small>` : ''}</dd></div>`)
+    .join('');
+  const stepsHtml = steps.filter(Boolean).map((s) => `<li>${escapeHtml(s)}</li>`).join('');
+  return `
+    <div class="result-primary">
+      <span class="result-label">${escapeHtml(primaryLabel)}</span>
+      <strong class="result-value" data-testid="primary-result">${escapeHtml(primaryValue)}</strong>
+    </div>
+    ${warning ? `<p class="result-warning" role="status">${escapeHtml(warning)}</p>` : ''}
+    <dl class="result-rows">${rowsHtml}</dl>
+    <details class="result-steps" open>
+      <summary>${escapeHtml(howLabel)}</summary>
+      <ol>${stepsHtml}</ol>
+    </details>
+    <p class="result-disclaimer">${escapeHtml(disclaimer)}</p>`;
+}
+
+/** Plain-text version of results for the copy button. */
+export function resultsToText(container) {
+  const parts = [];
+  const primary = container.querySelector('.result-primary');
+  if (primary) parts.push(`${primary.querySelector('.result-label').textContent}: ${primary.querySelector('.result-value').textContent}`);
+  container.querySelectorAll('.result-row').forEach((row) => {
+    parts.push(`${row.querySelector('dt').textContent}: ${row.querySelector('dd').firstChild?.textContent ?? ''}`);
+  });
+  const steps = [...container.querySelectorAll('.result-steps li')].map((li, i) => `${i + 1}. ${li.textContent}`);
+  if (steps.length) parts.push('', ...steps);
+  return parts.join('\n');
+}
+
+/** Read the stored/preferred unit system. */
+export function initialSystem(lang) {
+  try {
+    const stored = localStorage.getItem(STORAGE_KEY);
+    if (stored === 'metric' || stored === 'imperial') return stored;
+  } catch { /* storage unavailable */ }
+  // Spanish pages default to metric; English pages follow the browser locale
+  // (US / Liberia / Myanmar → imperial). The choice is persisted once toggled.
+  if (lang !== 'en') return 'metric';
+  const nav = (typeof navigator !== 'undefined' && navigator.language) || '';
+  if (/-(US|LR|MM)$/i.test(nav) || /^en$/i.test(nav)) return 'imperial';
+  return 'metric';
+}
+
+export function storeSystem(id) {
+  try { localStorage.setItem(STORAGE_KEY, id); } catch { /* ignore */ }
+}
