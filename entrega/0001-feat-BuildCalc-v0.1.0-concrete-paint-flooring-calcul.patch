+      </nav>
+      <header class="page-head">
+        <h1 id="calc-title">Concrete calculator</h1>
+        <p class="lead">Find out how many cubic yards or cubic metres of concrete you need for a slab, footing, sidewalk or column, and how many bags of pre-mix to buy.</p>
+      </header>
+      <div class="calc-layout">
+        <div>
+    <form class="calc-form card" data-calc="concrete" novalidate aria-labelledby="calc-title">
+      <fieldset class="unit-fieldset">
+        <legend>Unit system</legend>
+        <div class="segmented" role="radiogroup" aria-label="Unit system">
+          <label><input type="radio" name="units" value="metric" checked><span>Metric</span></label>
+          <label><input type="radio" name="units" value="imperial"><span>Imperial</span></label>
+        </div>
+      </fieldset>
+      <fieldset>
+        <legend>Shape</legend>
+        <div class="radio-list">
+          <label class="radio-card"><input type="radio" name="shape" value="slab" checked> Slab / footing (rectangular)</label>
+          <label class="radio-card"><input type="radio" name="shape" value="cylinder"> Round column (cylinder)</label>
+        </div>
+      </fieldset>
+      <div class="field-grid cols-3" data-show-when="shape=slab">
+        <div class="field" data-field="length">
+          <label for="c-length">Length <span class="unit" data-unit-role="length"></span></label>
+          <input id="c-length" name="length" type="number" inputmode="decimal" step="any" min="0" data-role="length" required aria-describedby="c-length-err" data-placeholder-metric="5" data-placeholder-imperial="16" autocomplete="off">
+          
+          <p class="field-error" id="c-length-err" hidden></p>
+        </div>
+        <div class="field" data-field="width">
+          <label for="c-width">Width <span class="unit" data-unit-role="length"></span></label>
+          <input id="c-width" name="width" type="number" inputmode="decimal" step="any" min="0" data-role="length" required aria-describedby="c-width-err" data-placeholder-metric="4" data-placeholder-imperial="12" autocomplete="off">
+          
+          <p class="field-error" id="c-width-err" hidden></p>
+        </div>
+        <div class="field" data-field="thickness">
+          <label for="c-thickness">Thickness <span class="unit" data-unit-role="small"></span></label>
+          <input id="c-thickness" name="thickness" type="number" inputmode="decimal" step="any" min="0" data-role="small" required aria-describedby="c-thickness-err" data-placeholder-metric="10" data-placeholder-imperial="4" autocomplete="off">
+          
+          <p class="field-error" id="c-thickness-err" hidden></p>
+        </div>
+      </div>
+      <div class="field-grid" data-show-when="shape=cylinder" hidden>
