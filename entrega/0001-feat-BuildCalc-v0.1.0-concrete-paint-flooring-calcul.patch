+{
+  "name": "BuildCalc",
+  "short_name": "BuildCalc",
+  "description": "Construction calculators: concrete, paint, flooring.",
+  "icons": [
+    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" },
