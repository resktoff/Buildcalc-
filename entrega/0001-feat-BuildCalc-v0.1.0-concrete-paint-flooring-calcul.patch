+    </form>
+        </div>
+        <section class="results card" id="results" data-state="empty" aria-labelledby="results-title" aria-live="polite">
+          <h2 id="results-title">Resultados</h2>
+          <div data-results-body><p class="results-placeholder">Completa los campos para ver el resultado al instante.</p></div>
+          <div class="results-actions">
+            <button type="button" class="btn btn-ghost btn-sm" data-copy>Copiar resultados</button>
