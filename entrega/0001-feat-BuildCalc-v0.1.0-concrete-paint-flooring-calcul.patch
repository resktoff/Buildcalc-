+          
+          <p class="field-error" id="f-ppb-err" hidden></p>
+        </div>
+      </div>
+      <div data-show-when="boxMode=area" hidden>
+        <div class="field" data-field="boxArea">
+          <label for="f-box-area">Área que cubre una caja <span class="unit" data-unit-role="area"></span></label>
+          <input id="f-box-area" name="boxArea" type="number" inputmode="decimal" step="any" min="0" data-role="area" required aria-describedby="f-box-area-err" data-placeholder-metric="1.44" data-placeholder-imperial="16" autocomplete="off">
+          
